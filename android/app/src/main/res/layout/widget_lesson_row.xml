<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_lesson_time"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:maxLines="2"
        android:text="08:30\n10:30"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_lesson_accent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/widget_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_lesson_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="9dp">

        <TextView
            android:id="@+id/widget_lesson_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Insegnamento"
            android:textColor="@color/widget_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_lesson_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aula"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
